  "implemented": {
    "provider_crud": "Native DTOs persist and safely round-trip secondary credentials, custom OAuth URLs, mapping, receiver, sender/TLS/SMS configuration and existing write-only fields. Native and compatibility writes share effective-row validation and row-locked marker retention.",
    "secret_policy": "Known public metadata is visible, secret values are masked and unknown metadata remains opaque but preserved. Partial object updates retain hidden values; HTTP header credentials match by case-insensitive name, not array position. Missing-original markers, invalid configuration, silent secret-to-public reclassification and stale-secret restoration fail atomically. Actual fallback token carriers are masked while ordinary public client IDs remain visible.",
    "email_and_dispatch": "Email client_id2 selects From address and public Email client_secret2 selects From name; SMTP and SendGrid payloads consume the saved name. SMTP uses implicit TLS on 465, required STARTTLS on other default ports, and opportunistic STARTTLS with plaintext fallback only for explicit disable_ssl. Local wire checks reject credential/DATA leakage before a failed TLS handshake, and verify SMTP AUTH/headers, SendGrid payloads, HTTP SMS and notification header/default-receiver configuration.",
    "oauth_mapping": "Custom/OIDC authenticated user-info responses support the upstream eight mapping fields and dotted object paths. Stable subject is required, exact integer conversion is bounded, new users consume mapped username/contact/profile, verified contacts require valid syntax, existing account/MFA contacts remain unchanged, and matching email or username never links an existing account.",
    "oauth_scopes_and_okta": "Saved scopes affect actual sign-in/link authorization queries for supported built-ins, including DingTalk; empty settings keep defaults and no-scope protocols explicitly reject unsupported settings. Generic authorization URLs retain unrelated query parameters. Okta prefers complete Domain issuer paths, then issuer_url, retaining the legacy custom-auth-origin fallback and Basic Auth token exchange.",
    "oauth_network_policy": "Generic and configurable Okta server requests use checked DNS, no proxy/redirects, time and JSON bounds. Explicit real-global-administrator approval grants private network access for the current configuration; a fresh UUID generation invalidates earlier flows on reapproval. Role/account status is rechecked transactionally; owner spelling, metadata booleans and virtual administrators never grant approval. Callback, link and MFA/completion recheck current configuration and grant generation.",
    "frontend": "Glory/Sapid Provider editing, public From name vs secret controls, explicit credential/metadata clearing, custom OAuth mapping/scopes/issuer fields and real global approval actions; five new real-backend browser workflows retain all 31 preceding checks.",
    "ipv6": "Checked socket resolution supports URL-bracketed IPv6 literals while retaining private-address denial; a real IPv6 loopback HTTP regression exercises both policies."
  },
  "limits": {
    "oauth": "Explicit HTTP(S) endpoints only; no userinfo/fragment. DNS/connection/request bounds 3/2/8 seconds, response JSON at most 1 MiB, code at most 8192 bytes, access token at most 16384. No URL templates, issuer discovery or decoded-unverified-ID-token identity.",
    "mapping": "Eight named targets, at most 16 dotted segments and 512 bytes per path; mapping validation fails explicitly for unsupported shapes. phoneVerified is an external profile claim, not local MFA proof. Built-in provider-specific mapping behavior beyond the Generic path is not claimed.",
    "approval": "Server-side grant in shared PostgreSQL, bound to identity/transport configuration and a random generation. Upgrading invalidates old pending OAuth proofs without stamps; users restart sign-in, with existing proof TTL at most five minutes. In-flight operations cannot be undone, and final account authorization still rechecks the grant.",
    "smtp": "Current boolean/port behavior is tested; full upstream sslMode Auto/Enable/Disable is not implemented. Plaintext is permitted only by explicit configuration; TLS peer verification remains enabled."
  },
