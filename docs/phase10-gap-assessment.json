    "keycloak": [
      "Typed bounded PBKDF2-SHA256/SHA512 encoding preserves Base64 binary salts, derived lengths and iterations with constant-time verification.",
      "Source users, credentials, groups and federation are read in one schema-qualified repeatable-read transaction; malformed/unknown credentials and group errors reject the batch.",
      "Only explicit federation permits profiles without a password; unchanged source credentials preserve successful local Argon upgrades."
    ],
    "runtime_pools": [
      "Immutable SQLx/Diesel/Casbin request generations; new requests and workers use the current generation while old transactions drain naturally.",
      "Persisted startup settings, shared settings polling, serialized validated publication and truthful failure status retaining the active generation.",
      "Actual open/idle ceilings and checkout lifetime checks on both drivers. Zero open is resolved from PostgreSQL max_connections, zero idle means two bounded idle connections and zero lifetime means no age limit.",
      "Limits apply separately per driver and generation, rather than a combined process-wide physical connection ceiling. External Syncer pools remain independent."
    ],
    "themes": [
      "Transactional eight-field backup/restore including SQL NULL themeData, UUID-bound single-theme constraint, current administrator/tenant checks and live public branding validation.",
      "Explicit static HTML/CSS safety subset; global approval for additional static asset URLs is bound to the current theme fingerprint.",
      "Glory/Sapid Marketplace selection and real login/signup/authorization rendering, desktop/mobile styles and backgrounds, upstream formOffset enum, scoped CSS and sandboxed side/footer HTML.",
      "Cleanup and request generations prevent cross-application residue; browser assertions wait for actual iframe text rather than only iframe existence."
    ],
    "frontend_profile": [
      "The profile form waits for initial account data before exposing editable fields, preventing a slow lookup from overwriting user input; a controlled delayed-response regression retains the exact saved-value assertion."
    ],
