  "implemented": {
    "cart": "Persistent per-user UUID cart with CAS revisions; one multi-SKU order and one payment, integer coupon allocation, per-line inventory and benefits, durable checkout replay, Stripe/PayPal recovery and cancellation, current quote validation and invalid-row removal.",
    "legacy_contract": "Self-owned User.cart/cartRevision read/write and place-order/get-order productInfos/products snapshot projection; pinned-buyer reads of orders and payments; unchanged full-user fields accepted, simultaneous profile changes rejected atomically.",
    "pricing_access": "Native and compatibility CRUD for isInviteOnly/users; exact current usernames and owner semantics; current catalog, checkout, first payment and renewal enforcement; future names allowed; whitelist omitted from store catalog.",
    "sms_restore": "phonenumber validation and E.164 normalization from national phone plus ISO region, including CN/US/PL; rejects invalid regions, actual invalid numbers, extensions and region mismatch.",
    "ldap": "RFC2696 paging with opaque cookies, empty intermediate pages, ignored noncritical control fallback to complete unpaged result, and actual-count bounds; complete snapshot before atomic reconcile."
  },
  "limits": {
    "cart": "At most 100 variants, ordinary quantity at most 1000, plan quantity at most 120; one currency and one checkout coupon; recharge cannot use Balance or coupons.",
    "ldap": "Requested page size 500, at most 100 pages/10000 entries/32 MiB; explicit failure on truncated or malformed pages, duplicate stable identities and incomplete paging.",
    "restore": "Ordinary user uploads retain MFA downgrade guards; explicit trusted restore remains create-only, administrator-scoped and bound to actual application delivery configuration."
  },
